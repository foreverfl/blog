---
import Base from "../../../layouts/Base.astro";
import DietIsland from "@/components/islands/DietIsland";

export function getStaticPaths() {
  return ["en", "ko", "ja"].map((lan) => ({ params: { lan } }));
}

const { lan } = Astro.params;
---

<Base lang={lan} title="Diet | mogumogu's blog">
  <DietIsland client:only="react" lan={lan} />
</Base>
